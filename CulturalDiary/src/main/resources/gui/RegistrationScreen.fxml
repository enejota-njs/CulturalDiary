<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane maxHeight="600.0" maxWidth="750.0" minHeight="600.0" minWidth="750.0" prefHeight="600.0" prefWidth="750.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.RegistrationController">
  <tabs>
    <Tab text="    Livro    ">
         <content>
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
               <children>
                  <VBox layoutX="37.0" layoutY="44.0" prefHeight="421.0" prefWidth="677.0">
                     <children>
                        <Label text="Título" />
                        <TextField fx:id="txtTitle" prefHeight="32.0" prefWidth="677.0" promptText="Digite o título">
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </TextField>
                        <Label text="Autor" />
                        <TextField fx:id="txtAuthor" prefHeight="32.0" prefWidth="305.0" promptText="Digite o autor">
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </TextField>
                        <Label text="Editora" />
                        <TextField fx:id="txtPublisher" cache="true" prefHeight="32.0" prefWidth="305.0" promptText="Digite a editora">
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </TextField>
                        <Label text="ISBN" />
                        <TextField fx:id="txtIsbn" prefHeight="32.0" prefWidth="305.0" promptText="Digite o ISBN">
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </TextField>
                        <HBox prefHeight="69.0" prefWidth="677.0" spacing="40.0">
                           <children>
                              <VBox prefHeight="46.0" prefWidth="307.0">
                                 <children>
                                    <Label text="Ano de publicação" />
                                    <TextField fx:id="txtYearOfPublication" cache="true" prefHeight="32.0" prefWidth="307.0" promptText="Digite a editora">
                                       <VBox.margin>
                                          <Insets bottom="20.0" />
                                       </VBox.margin>
                                    </TextField>
                                 </children>
                              </VBox>
                              <VBox prefHeight="42.0" prefWidth="330.0">
                                 <children>
                                    <Label text="Gênero" />
                                    <ComboBox fx:id="comboBoxGenre" prefHeight="25.0" prefWidth="338.0" promptText="Selecione o gênero" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <CheckBox fx:id="checkBoxHasCopy" mnemonicParsing="false" text="Marque esta opção se você possui um exemplar deste livro">
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </CheckBox>
                        <CheckBox fx:id="checkBoxRead" mnemonicParsing="false" text="Marque esta opção se você já leu este livro">
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </CheckBox>
                     </children>
                  </VBox>
                  <HBox layoutX="37.0" layoutY="504.0" prefHeight="35.0" prefWidth="677.0">
                     <children>
                        <Button fx:id="btnBack" mnemonicParsing="false" text="    Voltar    " />
                        <Button fx:id="btnRegister" mnemonicParsing="false" onAction="#registerBook" text="    Cadastrar    " translateX="510.0" />
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
         </content>
    </Tab>
    <Tab text="    Filme    ">
         <content>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" />
         </content>
    </Tab>
      <Tab text="    Série    ">
         <content>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" />
         </content>
      </Tab>
  </tabs>
</TabPane>
